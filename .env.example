# Docker Compose settings. These values select the image and host-side port mapping.
LIGHTBWS_IMAGE=ghcr.io/ca-x/lightbws:latest
LIGHTBWS_LISTEN_ADDRESS=127.0.0.1
LIGHTBWS_PORT=8080

# LightBWS runtime settings passed into the container.
LIGHTBWS_ADMIN_USERNAME=admin
# Required before the first `docker compose up`; use a unique strong password.
LIGHTBWS_ADMIN_PASSWORD=
LIGHTBWS_COOKIE_SECURE=false
RUST_LOG=lightbws=info,tower_http=info
# Behind a reverse proxy, the header that carries the client address, such as
# X-Real-IP. Needed for fail2ban and the login rate limit; see docs/fail2ban.md.
# Only set it when every request reaches LightBWS through that proxy.
# LIGHTBWS_IP_HEADER=
# Optional plain-text copy of the log for fail2ban, such as /logs/lightbws.log.
# LIGHTBWS_LOG_FILE=
# Recommended: leave this unset. LightBWS securely generates /data/master.key
# in the persistent volume; back that file up separately from .lightbws archives.
# Set this only for external key management, using exactly 32 random bytes
# encoded as 64 hexadecimal characters or unpadded Base64url.
# LIGHTBWS_MASTER_KEY=
# Unlocks plaintext as an opt-in choice for individual exports and backup targets.
# Encrypted mode remains the default. Plaintext archives can expose every secret.
LIGHTBWS_ALLOW_PLAINTEXT_BACKUPS=false
